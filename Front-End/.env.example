# API (see vite.config / deployment)
# VITE_API_URL=https://api.example.com

# Public media origin bound to the R2 bucket (no trailing slash).
# Used to detect R2 assets and rewrite pub-*.r2.dev → this host for Image Resizing.
# VITE_R2_PUBLIC_BASE_URL=https://media.yourdomain.com

# Cloudflare Image Resizing for R2/media hosts (1|true|yes|on). Keep 0 until CF is ready.
VITE_CF_IMAGE_RESIZING=0
