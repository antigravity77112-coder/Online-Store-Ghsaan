{
  "name": "yemeni-store-backend",
  "version": "1.0.0",
  "description": "Node.js backend for Yemeni E-commerce store (converted from C#/.NET)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "vercel-build": "prisma generate",
    "postinstall": "prisma generate",
    "backup:export": "node scripts/export-app-backup.js",
    "backup:pg-dump": "node scripts/pg-dump-backup.js",
    "backup:keep-alive": "node scripts/keep-alive.js",
    "migrate:inventory": "node src/scripts/migration/inventory-cloudinary.js",
    "migrate:backup": "node src/scripts/migration/backup-cloudinary.js",
    "migrate:r2": "node src/scripts/migration/migrate-to-r2.js",
    "migrate:db-dry-run": "node src/scripts/migration/rewrite-db-urls.js --dry-run",
    "migrate:db-execute": "node src/scripts/migration/rewrite-db-urls.js --execute",
    "migrate:db-rollback": "node src/scripts/migration/rewrite-db-urls.js --rollback",
    "migrate:recompress-dry": "node src/scripts/migration/recompress-r2-library.js --dry-run",
    "migrate:recompress": "node src/scripts/migration/recompress-r2-library.js",
    "migrate:recompress-db-dry": "node src/scripts/migration/rewrite-recompress-urls.js --dry-run",
    "migrate:recompress-db-execute": "node src/scripts/migration/rewrite-recompress-urls.js --execute",
    "migrate:recompress-db-rollback": "node src/scripts/migration/rewrite-recompress-urls.js --rollback",
    "test:storage": "node --test src/services/storage/__tests__/*.test.js src/scripts/migration/lib/__tests__/*.test.js",
    "test:coupons": "node --test src/services/__tests__/couponService.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.20.0",
    "prisma": "^5.22.0",
    "streamifier": "^0.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
