# Node.js Backend Environment Variables
# Copy this file to .env and fill in the values

# Server Configuration
PORT=5000

# Database Connection (Supabase PostgreSQL)
# App runtime (Node API): Supabase *transaction* pooler on port 6543 + pgbouncer=true.
# Example:
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
#
# prismaClient.js adds connection_limit / pool_timeout when omitted:
#   - Local `npm run dev`: connection_limit=10, pool_timeout=30 (concurrent API requests)
#   - Vercel/serverless: connection_limit=1, pool_timeout=10
# Override anytime via query params on DATABASE_URL (explicit values are never overwritten).
DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true

# Migrations / introspection: session pooler on port 5432 (or direct DB host).
# Direct host db.[ref].supabase.co may be IPv6-only and fail on some networks.
DIRECT_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# Prisma client pool (defaults: local connection_limit=5 pool_timeout=20; production=1/10).
# Raise if you see "Timed out fetching a new connection from the connection pool".
# PRISMA_CONNECTION_LIMIT=5
# PRISMA_POOL_TIMEOUT=20

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=1h
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated allowed frontend origins (production)
ALLOWED_ORIGIN=https://online-store-ghsaan.vercel.app

# Currency Converter Configuration (Exchange Rates)
# These rates are used to convert between currencies
USD_TO_YER_SANAA_RATE=530
USD_TO_YER_ADEN_RATE=1650

# File Upload Configuration
# Maximum file size for uploads (in bytes)
MAX_FILE_SIZE=5242880 # 5MB
MAX_BACKUP_SIZE=52428800 # 50MB

# Allowed file types for uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Optional: Expo Push API access token (https://expo.dev/accounts/[account]/settings/access-tokens)
# Improves reliability / rate limits when sending pushes from the backend
EXPO_ACCESS_TOKEN=

# Optional: node create-admin.js — create or reset admin (leave unset if admins are managed only in Supabase)
# ADMIN_EMAIL=your-admin@example.com
# ADMIN_PASSWORD=your-password