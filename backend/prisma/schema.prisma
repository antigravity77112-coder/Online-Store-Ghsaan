  aboutUsText       String   @default("سوق إلكتروني يمني يوفر أفضل المنتجات...")
  /// Editable privacy policy body (storefront /privacy-policy)
  privacyPolicyText String?
  contactEmail      String   @default("info@al-gaadi.com")
  contactPhone      String   @default("+967 77X XXX XXX")
  shippingOfferText String   @default("شحن مجاني للطلبات فوق 50$")
  facebookUrl       String?
  twitterUrl        String?
  whatsappUrl       String?
  /// Up to 4 labeled WhatsApp contacts: [{ label, url }]
  whatsappContacts  Json?
  instagramUrl      String?
  tiktokUrl         String?
  telegramUrl       String?
  linkedinUrl       String?
  threadsUrl        String?
  seoTitle          String?
  seoDescription    String?
  siteName          String   @default("Smart Shopper | المتسوق الذكي")
  siteShortName     String   @default("Smart Shopper")
  appName           String   @default("Smart Shopper | المتسوق الذكي")
  tagline           String   @default("تسوق ذكي — منتجات متنوعة بأسعار منافسة")
  siteDescription   String?
  copyrightText     String?
  logoUrl           String?
  logoDarkUrl       String?
  logoMobileUrl     String?
  logoMobileDarkUrl String?
  faviconUrl        String?
  ogImageUrl        String?
  ogTitle           String?
  ogDescription     String?
  address           String?
  mapUrl            String?
  youtubeUrl        String?
  footerText        String?
  footerLinks       Json?
  themeConfig       Json?
  homepageConfig    Json?
  /// USD-hub display rates: { USD_to_YER_Sanaa, USD_to_YER_Aden, USD_to_SAR }
  exchangeRates     Json?
  updatedAt         DateTime @updatedAt
}

model Banner {
  id             String          @id @default(uuid()) @db.Uuid
  title          String
  subtitle       String?
  description    String?
  ctaText        String?
  ctaUrl         String?
  imageUrl       String?
  mobileImageUrl String?
  bgColor        String?
  /// Text color for announcement ticker (e.g. #ffffff).
  textColor      String?
  /// Seconds for one full marquee loop on announcement placement (8–120).
  scrollSpeed    Int             @default(40)
  textAlign      String          @default("right")
  overlayOpacity Int             @default(30)
  placement      BannerPlacement @default(promo_home)
  status         BannerStatus    @default(draft)
  showOnDesktop  Boolean         @default(true)
  showOnMobile   Boolean         @default(true)
  priority       Int             @default(0)
  scheduledAt    DateTime?
  expiresAt      DateTime?
  impressions    Int             @default(0)
  clicks         Int             @default(0)
  /// Hero placement: up to 2 product IDs shown as peek cards (Shein-style)
  peekProductIds Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([placement, status, priority])
  @@index([status, scheduledAt])
}

model RateLimit {
  key       String   @id
  hits      Int      @default(0)
  resetTime DateTime
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  userId     String    @db.Uuid
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  replacedBy String?   @db.Uuid
  userAgent  String?
  ipAddress  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Branch {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  address      String
  city         String
  latitude     Float?
  longitude    Float?
  phone        String?
  whatsapp     String?
  workingHours String?
  mapUrl       String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([createdAt(sort: Desc)])
}

enum DevicePlatform {
  ios
  android
  unknown
}

enum NotificationDeliveryStatus {
  pending
  sent
  failed
  invalid_token
}

enum NotificationChannel {
  orders
  engagement
  marketing
  system
}

enum NotificationCampaignAudience {
  all_customers
  admins
}

/// Expo push token bound to a logged-in user (multi-device supported).
model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String         @unique
  platform   DevicePlatform @default(unknown)
  appVersion String?
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  deliveries NotificationDelivery[]

  @@index([userId])
}

/// Per-user channel preferences. Transactional order pushes stay enabled.
model NotificationPreference {
  userId             String  @id @db.Uuid
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ordersEnabled      Boolean @default(true)
  engagementEnabled  Boolean @default(true)
  marketingEnabled   Boolean @default(true)
  updatedAt          DateTime @updatedAt
}

/// In-app notification history + dedupe source of truth.
model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  channel   NotificationChannel @default(orders)
  /// Minimal routing payload: { type, orderId?, entityId?, productId? }
  data      Json?
  /// Unique event key to prevent duplicate pushes (e.g. userId:order_status:orderId:Shipped)
  dedupeKey String              @unique
  readAt    DateTime?
  createdAt DateTime            @default(now())

  deliveries NotificationDelivery[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@index([channel, createdAt(sort: Desc)])
}

/// Admin-composed broadcast audit trail.
model NotificationCampaign {
  id          String                       @id @default(uuid()) @db.Uuid
  title       String
  body        String
  data        Json?
  /// engagement | marketing only for customer broadcasts
  channel     NotificationChannel
  audience    NotificationCampaignAudience
  createdById String                       @db.Uuid
  createdBy   User                         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  sentCount   Int                          @default(0)
  createdAt   DateTime                     @default(now())

  @@index([createdAt(sort: Desc)])
}

model NotificationDelivery {
  id               String                      @id @default(uuid()) @db.Uuid
  notificationId   String                      @db.Uuid
  notification     Notification                @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  deviceTokenId    String                      @db.Uuid
  deviceToken      DeviceToken                 @relation(fields: [deviceTokenId], references: [id], onDelete: Cascade)
  status           NotificationDeliveryStatus  @default(pending)
  providerResponse String?
  attempts         Int                         @default(0)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@unique([notificationId, deviceTokenId])
  @@index([status, createdAt])
}

